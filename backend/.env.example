# Database (MongoDB)
DATABASE_URL="mongodb://localhost:27017/saka_sms"
# MongoDB Atlas (production):
# DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/saka_sms?retryWrites=true&w=majority"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# File Storage (local dev)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Optional: Email (for notifications)
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""

# Razorpay Payment Gateway (https://razorpay.com)
# Get test keys from: Dashboard → Settings → API Keys
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXXXXXX"
